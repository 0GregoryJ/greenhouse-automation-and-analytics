# Copy to .env on each host and fill in the blank or placeholder values.
# Values marked "default" match the application defaults. Leave a variable out to use the default,
# but do not leave it set to an empty value: an empty value is still "set" and overrides the default.
# No secrets or credentials belong in Git; .env is git-ignored.

# --------------------------------------------------
# MQTT (Raspberry Pi gateway and Mac simulator)
# --------------------------------------------------
# Gateway ingestor (Pi) reads MQTT_USERNAME, MQTT_PASSWORD, MQTT_PORT, MQTT_SENSOR_TOPIC, MQTT_AUTOMATION_TOPIC
# and always connects to localhost.
# Automation controller (Pi) reads the same variables plus MQTT_HOST (default localhost).
# Simulator (Mac) reads MQTT_HOST, MQTT_PORT, MQTT_USERNAME, MQTT_PASSWORD, MQTT_TOPIC.
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Sensor telemetry topic (default). The simulator reads MQTT_TOPIC instead; keep the two equal.
MQTT_SENSOR_TOPIC=greenhouse/telemetry
MQTT_TOPIC=greenhouse/telemetry

# Actuator event topic (default)
MQTT_AUTOMATION_TOPIC=greenhouse/automation/events

# --------------------------------------------------
# Automation controller (Raspberry Pi)
# --------------------------------------------------
# MQTT topic prefixes (Shelly device ids) of the fan and pump plugs. Required: the controller exits without them.
SHELLY_FAN_ID=
SHELLY_PUMP_ID=

# --------------------------------------------------
# Kafka (all hosts)
# --------------------------------------------------
# Broker address reachable through Tailscale, for example <TAILSCALE_IP>:9092 (required)
KAFKA_BOOTSTRAP_SERVERS=

# Topics (defaults). The Pi producer and the live consumer read both; the historical consumer
# reads KAFKA_TOPIC from here and uses the default automation topic unless compose.yaml forwards an override.
KAFKA_TOPIC=greenhouse.sensor-readings
KAFKA_AUTOMATION_TOPIC=greenhouse.automation.events.v1

# --------------------------------------------------
# Gateway SQLite -> Kafka producer (Raspberry Pi; defaults)
# --------------------------------------------------
KAFKA_BATCH_SIZE=100
KAFKA_RETRY_SECONDS=5
KAFKA_DELIVERY_TIMEOUT_MS=60000

# --------------------------------------------------
# Live Kafka -> Redis consumer (serving EC2; default)
# --------------------------------------------------
# Changing the group name replays the retained topics into Redis.
LIVE_KAFKA_CONSUMER_GROUP=greenhouse-live-dev

# --------------------------------------------------
# Historical Kafka -> S3 consumer (serving EC2)
# --------------------------------------------------
# Consumer group (default). Changing it re-archives the retained topics as new objects.
HISTORICAL_KAFKA_CONSUMER_GROUP=greenhouse-historical

# Flush a batch at this many events or this many seconds, whichever comes first (defaults)
HISTORICAL_BATCH_SIZE=240
HISTORICAL_FLUSH_SECONDS=300

# Destination bucket (required by the historical consumer). Sensor objects are written under
# s3://<S3_BUCKET>/<S3_PREFIX>/year=YYYY/month=MM/day=DD/...
# Automation events use raw/automation_events and malformed messages raw/quarantine
# (S3_AUTOMATION_PREFIX and S3_QUARANTINE_PREFIX in the consumer; not forwarded by compose.yaml).
# AWS credentials come from the EC2 instance profile, not from this file.
S3_BUCKET=
S3_PREFIX=raw/sensor_events
AWS_REGION=us-east-2

# --------------------------------------------------
# FastAPI (serving EC2)
# --------------------------------------------------
# Browser origins allowed to call the API, comma-separated. The default is local development only;
# add the dashboard origin in production.
CORS_ORIGINS=http://localhost:5173


# --------------------------------------------------
# Snowflake historical analytics API (serving EC2)
# --------------------------------------------------
SNOWFLAKE_ACCOUNT=YOUR_ORG-YOUR_ACCOUNT
SNOWFLAKE_USER=GREENHOUSE_API
SNOWFLAKE_ROLE=GREENHOUSE_API_READER
SNOWFLAKE_WAREHOUSE=GREENHOUSE_WH
SNOWFLAKE_DATABASE=GREENHOUSE_ANALYTICS
SNOWFLAKE_SCHEMA=GREENHOUSE_DBT_MARTS

# Absolute path to the RSA private key on the EC2 host. Compose mounts this file
# read-only into the API container at /run/secrets/snowflake_api_key.pem.
# The file must be readable by the container user (for example chmod 644, or
# owned by a group Docker can read).
SNOWFLAKE_KEY_HOST_PATH=/home/YOUR_EC2_USER/.ssh/greenhouse/snowflake_api_key.pem

# RSA private key passphrase
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=YOUR_KEY_PASSPHRASE


# --------------------------------------------------
# AI analyst (serving EC2)
# --------------------------------------------------
# Server-side only; never exposed to the dashboard. Compose refuses to start the API without it.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.5
# Approved metrics and dimensions the model may choose from (path inside the container).
ANALYST_CATALOG_PATH=/app/api/analyst_catalog.json
# The analyst runs approved queries through the API's own MetricFlow endpoint.
METRICS_API_URL=http://127.0.0.1:8000/api/metrics/query
# MetricFlow reads the dbt profile from /home/ubuntu/.dbt on the host (mounted by compose.yaml).