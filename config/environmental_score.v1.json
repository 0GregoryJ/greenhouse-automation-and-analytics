{
  "version": "conditions-v2",
  "description": "Greenhouse environmental suitability with calibrated soil moisture percent",
  "max_reading_age_seconds": 180,
  "max_sensor_skew_seconds": 120,
  "metrics": {
    "air_temperature": {
      "unit": "celsius",
      "weight": 0.4,
      "target_min": 20,
      "target_max": 26,
      "tolerance_below": 8,
      "tolerance_above": 8,
      "valid_min": -10,
      "valid_max": 60
    },
    "relative_humidity": {
      "unit": "percent",
      "weight": 0.2,
      "target_min": 85,
      "target_max": 97,
      "tolerance_below": 35,
      "tolerance_above": 3,
      "valid_min": 0,
      "valid_max": 100
    },
    "soil_moisture": {
      "unit": "percent",
      "weight": 0.4,
      "target_min": 40,
      "target_max": 80,
      "tolerance_below": 40,
      "tolerance_above": 20,
      "valid_min": 0,
      "valid_max": 100,
      "calibration_status": "calibrated_pct_window"
    }
  }
}
